{
  "info": {
    "_postman_id": "product-crud-api",
    "name": "Product CRUD API",
    "description": "Complete RESTful API for Product management with CRUD operations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Fetch all products including their embedded category details"
          },
          "response": []
        },
        {
          "name": "Get Single Product",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Fetch details of a single product alongside its parent category data"
          },
          "response": []
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "category_id",
                  "value": "1",
                  "type": "text",
                  "description": "ID of the category - must exist in categories table"
                },
                {
                  "key": "name",
                  "value": "MacBook Pro M3",
                  "type": "text",
                  "description": "Product name (required, max 255 characters)"
                },
                {
                  "key": "price",
                  "value": "1999.99",
                  "type": "text",
                  "description": "Product price (required, numeric, minimum 0)"
                },
                {
                  "key": "stock",
                  "value": "14",
                  "type": "text",
                  "description": "Product stock quantity (required, integer, minimum 0)"
                },
                {
                  "key": "is_active",
                  "value": "1",
                  "type": "text",
                  "description": "Product status (optional, boolean: 0 or 1)"
                },
                {
                  "key": "image",
                  "type": "file",
                  "description": "Product image file (optional, jpeg|png|jpg|gif, max 2MB)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Create a new product with optional file upload. Accept multi-part form inputs, validate properties, and persist data."
          },
          "response": []
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "category_id",
                  "value": "1",
                  "type": "text",
                  "description": "Product category ID (optional)"
                },
                {
                  "key": "name",
                  "value": "Updated MacBook Pro",
                  "type": "text",
                  "description": "Product name (optional)"
                },
                {
                  "key": "price",
                  "value": "2099.99",
                  "type": "text",
                  "description": "Product price (optional)"
                },
                {
                  "key": "stock",
                  "value": "20",
                  "type": "text",
                  "description": "Product stock (optional)"
                },
                {
                  "key": "is_active",
                  "value": "1",
                  "type": "text",
                  "description": "Product status (optional)"
                },
                {
                  "key": "image",
                  "type": "file",
                  "description": "New product image (optional - will replace old image if provided)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Update an existing product. Inspect for newly uploaded image file, delete old asset if replaced, and edit fields."
          },
          "response": []
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Delete a product and its image from storage disk. Safely removes the physical file asset then purges the database row record."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ]
}
